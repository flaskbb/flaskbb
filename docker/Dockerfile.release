# Release image: the latest stable FlaskBB from PyPI, served by gunicorn.
# The build context is this directory:
#
#   docker build -f docker/Dockerfile.release -t flaskbb:release docker/
#
# 2.2.0 annotates with a TYPE_CHECKING-only import in plugins/manager.py,
# which only imports on 3.14 (deferred annotations).
ARG PYTHON_VERSION=3.14
ARG UV_VERSION=0.12

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:${PYTHON_VERSION}-slim-trixie

COPY --from=uv /uv /uvx /usr/local/bin/

# Empty installs the latest release on PyPI. Pin one with
# --build-arg FLASKBB_VERSION=2.2.0 to stay on a known version.
ARG FLASKBB_VERSION=""

# Plugins from PyPI, resolved together with FlaskBB so only plugin versions
# that support it are picked, e.g.
# --build-arg FLASKBB_PLUGINS="flaskbb-plugin-portal flaskbb-plugin-conversations"
ARG FLASKBB_PLUGINS=""

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    FLASKBB_SETTINGS=/etc/flaskbb/flaskbb.cfg

# Flask creates its instance folder next to the venv, the app writes there
# and to its storage, everything else belongs to root.
RUN groupadd --gid 1000 flaskbb \
    && useradd --uid 1000 --gid 1000 --create-home flaskbb \
    && install -d -o flaskbb -g flaskbb \
        "$VIRTUAL_ENV/var/flaskbb-instance" \
        /var/lib/flaskbb /var/lib/flaskbb/avatars /var/lib/flaskbb/attachments

# The extras exist since 3.0, see "Known issues" in README.md.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --allow-existing "$VIRTUAL_ENV" \
    && uv pip install \
        "flaskbb[gunicorn,postgres,mysql]${FLASKBB_VERSION:+==${FLASKBB_VERSION}}" \
        $FLASKBB_PLUGINS

WORKDIR /app

COPY wsgi.py /app/wsgi.py
COPY flaskbb.cfg /etc/flaskbb/flaskbb.cfg
COPY healthcheck.py /usr/local/lib/flaskbb-docker/healthcheck.py
COPY entrypoint.sh /usr/local/bin/flaskbb-entrypoint

USER flaskbb
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=10 \
    CMD ["python", "/usr/local/lib/flaskbb-docker/healthcheck.py", "8000"]

ENTRYPOINT ["flaskbb-entrypoint"]
# Worker count comes from WEB_CONCURRENCY, everything else from GUNICORN_CMD_ARGS.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--access-logfile", "-", "wsgi:flaskbb"]
