# Copy to 'docker/.env' and adjust. The release stack passes every variable in
# here to its containers, the dev stack only reads the database, secret, host,
# search, log level and admin values.

# Database. The dev stack uses SQLite in the flaskbb-storage volume, set
# DATABASE_URI to use something else there. The release stack runs PostgreSQL
# with these credentials.
#DATABASE_URI=sqlite:////var/lib/flaskbb/flaskbb.sqlite
POSTGRES_USER=flaskbb
POSTGRES_PASSWORD=flaskbb
POSTGRES_DB=flaskbb

# Published port of the forum (5000 in the dev stack, 8000 in the release stack)
#FLASKBB_PORT=8000

# Secrets - generate with: python -c "import secrets; print(secrets.token_hex(24))"
# Required by the release stack, optional (insecure defaults) in the dev stack.
SECRET_KEY=
CSRF_SECRET_KEY=

# The administrator that is created on the first start. Without these three
# the container stops and asks you to run 'flaskbb install' yourself.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# Public name of the forum. Leave empty to accept any Host header, which is
# what you want while developing. Celery generated links (activation,
# password reset) need it.
#SERVER_NAME=forums.example.org
#TRUSTED_HOSTS=forums.example.org
#URL_SCHEME=https

# Set when the release stack runs behind a reverse proxy that sets the
# X-Forwarded-* headers.
#PROXY_FIX=1
#PROXY_FIX_HOPS=1

# Gunicorn worker processes (release stack)
#WEB_CONCURRENCY=4

# Mail. The dev stack talks to mailpit (http://localhost:8025) instead.
#MAIL_SERVER=smtp.example.org
#MAIL_PORT=587
#MAIL_USE_TLS=true
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_SENDER_NAME=FlaskBB Mailer
#MAIL_SENDER_ADDRESS=noreply@example.org
#MAIL_ADMIN_ADDRESS=admin@example.org

# Pin the release stack to a specific version instead of the latest one
#FLASKBB_VERSION=2.2.0

# Plugins of the release stack. FLASKBB_PLUGINS are the PyPI packages that are
# installed into the image (rebuild after changing them), FLASKBB_ENABLE_PLUGINS
# the names they register as ('flaskbb plugins list'). The entrypoint enables
# and installs every listed plugin that isn't enabled yet.
#FLASKBB_PLUGINS="flaskbb-plugin-portal flaskbb-plugin-conversations"
#FLASKBB_ENABLE_PLUGINS=portal,conversations

# Search backend: sql, postgresql or sqlite.
# Defaults to sqlite in the dev stack and postgresql in the release stack.
#SEARCH_BACKEND=sqlite

#LOG_LEVEL=INFO
